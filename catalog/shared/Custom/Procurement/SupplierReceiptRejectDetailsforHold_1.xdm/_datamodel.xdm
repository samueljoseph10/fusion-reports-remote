               <element name="TOTAL_ACCEPTED_QTY" value="TOTAL_ACCEPTED_QTY" label="TOTAL_ACCEPTED_QTY" dataType="xsd:double" breakOrder="" fieldOrder="5"/>
               <element name="OVERALL_REJECT_PERCENT" value="OVERALL_REJECT_PERCENT" label="OVERALL_REJECT_PERCENT" dataType="xsd:double" breakOrder="" fieldOrder="6"/>
               <element name="TOTAL_RECEIVED_QTY" value="TOTAL_RECEIVED_QTY" label="TOTAL_RECEIVED_QTY" dataType="xsd:double" breakOrder="" fieldOrder="3"/>
               <group name="G_3" label="G_3" source="RECEIPT_DETAILS">
                  <element name="SUPPLIER_NAME" value="SUPPLIER_NAME" label="SUPPLIER_NAME" dataType="xsd:string" breakOrder="" fieldOrder="1"/>
                  <element name="RECEIPT_NUMBER" value="RECEIPT_NUMBER" label="RECEIPT_NUMBER" dataType="xsd:string" breakOrder="" fieldOrder="2"/>
                  <element name="PO_NUMBER" value="PO_NUMBER" label="PO_NUMBER" dataType="xsd:string" breakOrder="" fieldOrder="3"/>
                  <element name="TOTAL_RECEIVED_QTY" value="TOTAL_RECEIVED_QTY" label="TOTAL_RECEIVED_QTY" dataType="xsd:double" breakOrder="" fieldOrder="5"/>
                  <element name="REJECTED_QTY" value="REJECTED_QTY" label="REJECTED_QTY" dataType="xsd:double" breakOrder="" fieldOrder="6"/>
                  <element name="REJECT_PERCENT" value="REJECT_PERCENT" label="REJECT_PERCENT" dataType="xsd:double" breakOrder="" fieldOrder="7"/>
                  <element name="RISK_LEVEL" value="RISK_LEVEL" label="RISK_LEVEL" dataType="xsd:string" breakOrder="" fieldOrder="9"/>
                  <element name="RECEIPT_DATE" value="RECEIPT_DATE" label="RECEIPT_DATE" dataType="xsd:date" breakOrder="" fieldOrder="4" formatMask=""/>
                  <element name="RECEIPT_STATUS" value="RECEIPT_STATUS" label="RECEIPT_STATUS" dataType="xsd:string" breakOrder="" fieldOrder="8"/>
               </group>
            </group>
         </dataStructure>
