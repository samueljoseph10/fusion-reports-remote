<?xml version = '1.0' encoding = 'utf-8'?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1" xmlns:xdm="http://xmlns.oracle.com/oxp/xmlp" xmlns:xsd="http://wwww.w3.org/2001/XMLSchema" defaultDataSourceRef="Oracle BI EE">
   <dataProperties>
      <property name="include_parameters" value="true"/>
      <property name="include_null_Element" value="false"/>
      <property name="include_rowsettag" value="false"/>
      <property name="exclude_tags_for_lob" value="false"/>
      <property name="EXCLUDE_LINE_FEED_AND_CARRIAGE_RETURN_FOR_LOB" value="false"/>
      <property name="enable_sqlid_logging" value="true"/>
      <property name="xml_tag_case" value="upper"/>
      <property name="generate_output_format" value="xml"/>
      <property name="enforce_validation_status" value="true"/>
      <property name="optimize_query_executions" value="false"/>
      <property name="enable_xml_chunks" value=""/>
      <property name="sql_monitor_report_generated" value="false"/>
   </dataProperties>
   <dataSets>
      <dataSet name="SUPPLIER_SUMMARY" type="complex">
         <sql>
            <![CDATA[SET VARIABLE PREFERRED_CURRENCY='User Preferred Currency 1';

SELECT

"Receiving - Purchase Receipts Real Time"."Supplier Profile"."Supplier Name"
   AS SUPPLIER_NAME,

COUNT(DISTINCT "Receiving - Purchase Receipts Real Time"."- Purchase Receipt Header Details"."Receipt Number")
   AS TOTAL_RECEIPTS,

SUM("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity")
   AS TOTAL_RECEIVED_QTY,

SUM("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity")
   AS TOTAL_REJECTED_QTY,

SUM(
 "Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity"
 -
 "Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity"
) AS TOTAL_ACCEPTED_QTY,

ROUND(
 SUM("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity") * 100.0
 /
 NULLIF(SUM("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity"),0),
2) AS OVERALL_REJECT_PERCENT

FROM "Receiving - Purchase Receipts Real Time"

GROUP BY
"Receiving - Purchase Receipts Real Time"."Supplier Profile"."Supplier Name"

ORDER BY 1]]>
         </sql>
      </dataSet>
      <dataSet name="RECEIPT_DETAILS" type="complex">
         <sql>
            <![CDATA[SET VARIABLE PREFERRED_CURRENCY='User Preferred Currency 1';

SELECT

"Receiving - Purchase Receipts Real Time"."Supplier Profile"."Supplier Name"
   AS SUPPLIER_NAME,

"Receiving - Purchase Receipts Real Time"."- Purchase Receipt Header Details"."Receipt Number"
   AS RECEIPT_NUMBER,

"Receiving - Purchase Receipts Real Time"."Purchase Order Header Details"."Order"
   AS PO_NUMBER,

"Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Creation Date Line"
   AS RECEIPT_DATE,

"Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity"
   AS TOTAL_RECEIVED_QTY,

"Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity"
   AS REJECTED_QTY,

-- %
CASE 
 WHEN "Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity" = 0 
 THEN 0
 ELSE ROUND(
   ("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity" * 100.0)
   /
   "Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity",
 2)
END AS REJECT_PERCENT,

-- STATUS
CASE
 WHEN "Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity" > 0
 THEN 'REJECTED RECEIPT'
 ELSE 'OK RECEIPT'
END AS RECEIPT_STATUS,

-- RISK
CASE
 WHEN "Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity" = 0
 THEN 'NO RISK'

 WHEN ROUND(
      ("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity" * 100.0)
      /
      NULLIF("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity",0),
      2) > 20
 THEN 'HIGH RISK'

 WHEN ROUND(
      ("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Rejected Quantity" * 100.0)
      /
      NULLIF("Receiving - Purchase Receipts Real Time"."- Purchase Receipt Line Details"."Received Quantity",0),
      2) BETWEEN 5 AND 20
 THEN 'MEDIUM RISK'

 ELSE 'LOW RISK'
END AS RISK_LEVEL

FROM "Receiving - Purchase Receipts Real Time"

ORDER BY
SUPPLIER_NAME,
RECEIPT_NUMBER]]>
         </sql>
      </dataSet>
   </dataSets>
   <output rootName="DATA_DS" uniqueRowName="false">
